# systemd unit for the GTS website. Installed to /etc/systemd/system/gts.service
# by deploy/setup.sh. /var/www/gts/current is a symlink to the live release,
# switched by deploy/deploy.sh.

[Unit]
Description=GTS Trade Solutions website (Next.js)
After=network-online.target mysql.service
Wants=network-online.target

[Service]
Type=simple
User=gts
Group=gts
WorkingDirectory=/var/www/gts/current
Environment=NODE_ENV=production
# Bound to loopback only: nginx is the sole way in.
ExecStart=/usr/bin/node node_modules/next/dist/bin/next start --hostname 127.0.0.1 --port 3000
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
