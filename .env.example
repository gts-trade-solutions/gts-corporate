# ---------------------------------------------------------------------------
# GTS Trade Solutions — environment configuration
# Copy to .env.local for development, or set these in your hosting dashboard.
# ---------------------------------------------------------------------------

# Public site URL. Used for canonical tags, Open Graph URLs, sitemap and robots.
# No trailing slash.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# ---------------------------------------------------------------------------
# Contact channels
#
# The site has no Call button anywhere — WhatsApp, email and the enquiry form
# are the published routes. Each of the three below is optional and shows up
# the moment it is set: in the header utility row, the footer, the mobile
# menu, the contact page, the "Talk to an expert" band and the floating rail.
# Left unset, that channel is skipped rather than rendering a dead link.
# ---------------------------------------------------------------------------

# Public enquiry email. This is what makes the address visible site-wide.
NEXT_PUBLIC_CONTACT_EMAIL=

# WhatsApp — the primary conversational channel. Country code and digits only,
# no spaces, plus or dashes. Example: 919600122296
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Microsoft Teams. Either a full meeting/chat URL, or a bare Teams address —
# an address is wrapped into a chat deep link automatically.
NEXT_PUBLIC_TEAMS_ID=

# ---------------------------------------------------------------------------
# RFQ form email delivery (server-side only — never exposed to the browser)
# ---------------------------------------------------------------------------

# Mailbox that receives enquiries. Required for the form to send email.
RFQ_TO_EMAIL=enquiries@example.com

# Address the site sends from. Should be on a domain you control and are
# authorised to send from (SPF/DKIM), otherwise mail will land in spam.
RFQ_FROM_EMAIL=website@example.com

# SMTP transport. Required for the form to send email.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Optional override. Defaults to true on port 465, false otherwise.
# SMTP_SECURE=false

# ---------------------------------------------------------------------------
# Analytics & Search Console (optional)
# ---------------------------------------------------------------------------

# GA4 measurement ID. The analytics script only loads when this is set.
NEXT_PUBLIC_GA_ID=

# Google Search Console HTML-tag verification token (the content value only).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ---------------------------------------------------------------------------
# Vehicle model admin (/admin)
# ---------------------------------------------------------------------------

# MySQL holds the editable vehicle model schedule: specifications, markets,
# priority parts and uploaded photographs. Leave these unset and the site
# serves the static catalogue in src/data/vehicle-models.ts and the admin is
# read-only. On first use against an empty database the catalogue is copied in.
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=

# Admin sign-in. Either one address and password:
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
# ...or one password per person, so each can be revoked on its own. The
# address is recorded in the session and shown in the admin header.
# ADMIN_USERS=first@example.com:their-password,second@example.com:another

# Optional. Signs the admin session cookie. Without it the key is derived from
# the credentials, which means changing a password signs everyone out — fine
# for a single server, but set an explicit random value if you run more than one.
# ADMIN_SESSION_SECRET=

# ---------------------------------------------------------------------------
# AI assistant and AI search (optional)
# ---------------------------------------------------------------------------

# Anthropic API key. Powers the site assistant (the chat launcher, bottom
# right) and the AI answer above the search results. Unset, the assistant tells
# visitors to use the enquiry form and search falls back to keyword results
# only — everything else on the site is unaffected.
#
# Both surfaces run claude-opus-5 at low effort and are grounded in the site's
# own index, so they can only point at pages that exist. See src/lib/assistant.ts.
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Enquiry follow-up reminders (optional)
# ---------------------------------------------------------------------------

# Shared secret for the reminder job at /api/reminders. Unset, the endpoint
# returns 404 and no reminders are ever sent. Use a long random value.
#
# Needs the MYSQL_* variables below as well: enquiries are recorded in an
# `enquiries` table so an unanswered one can be chased. Schedule an hourly
# request to:
#   https://your-domain/api/reminders?token=YOUR_SECRET
#
# Stage 1 nudges RFQ_TO_EMAIL 24 hours after an unanswered enquiry; stage 2
# follows up with the enquirer at 72 hours. Nothing is sent twice. Each
# internal reminder carries a one-click link that closes the enquiry.
# Add &report=1 to list what is still open without sending anything.
REMINDER_SECRET=
