# ---------------------------------------------------------------------------
# GTS Trade Solutions — environment configuration
# Copy to .env.local for development, or set these in your hosting dashboard.
# ---------------------------------------------------------------------------

# Public site URL. Used for canonical tags, Open Graph URLs, sitemap and robots.
# No trailing slash.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Optional public enquiry email. Shown in the header, footer and contact page.
# Leave unset until the final address is confirmed — nothing is displayed if empty.
NEXT_PUBLIC_CONTACT_EMAIL=

# Optional floating WhatsApp button. Set the confirmed number with country code
# (digits only) to enable it. Leave unset to hide the button.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# ---------------------------------------------------------------------------
# RFQ form email delivery (server-side only — never exposed to the browser)
# ---------------------------------------------------------------------------

# Mailbox that receives enquiries. Required for the form to send email.
RFQ_TO_EMAIL=enquiries@example.com

# Address the site sends from. Should be on a domain you control and are
# authorised to send from (SPF/DKIM), otherwise mail will land in spam.
RFQ_FROM_EMAIL=website@example.com

# SMTP transport. Required for the form to send email.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Optional override. Defaults to true on port 465, false otherwise.
# SMTP_SECURE=false

# ---------------------------------------------------------------------------
# Analytics & Search Console (optional)
# ---------------------------------------------------------------------------

# GA4 measurement ID. The analytics script only loads when this is set.
NEXT_PUBLIC_GA_ID=

# Google Search Console HTML-tag verification token (the content value only).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
